# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Optional. Used for ChatGPT and DALL-E integration if you prefer to use OpenAI.
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# XAI_API_KEY: Optional. Used for Grok API integration.
XAI_API_KEY="YOUR_XAI_API_KEY"

# REPLICATE_API_TOKEN: Optional. For FLUX.1 Dev photorealistic models via Replicate.
REPLICATE_API_TOKEN=""

# TOGETHER_API_KEY: Optional. For FLUX.1 Schnell via Together AI (free $5 starter credit on signup).
TOGETHER_API_KEY=""

# HF_TOKEN: Optional. Free Hugging Face user access token (no credit card needed).
HF_TOKEN=""


# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
